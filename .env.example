# ============================================================
# 管理员 & 代理商平台 - MySQL 数据库配置
# ============================================================
# 复制此文件为 .env.local 并填入真实值
# 宝塔面板部署时在网站目录中创建 .env.local 文件

# MySQL 数据库连接字符串
# 格式: mysql://用户名:密码@主机:端口/数据库名
# 示例: mysql://b2buser:b2bplatform_2026@localhost:3306/b2bplatform
DATABASE_URL=mysql://username:password@localhost:3306/database_name

# 网站公开 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# 阿里云 OCR 条形码识别配置（推荐）
# ============================================================
# 1. 在阿里云控制台开通 OCR 服务（通用文字识别或条形码识别）
# 2. 创建 AccessKey（注意：使用子账号并限制权限）
# 3. 将以下配置取消注释并填入真实值

ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret

# OCR.Space（免费备用，无需配置）
# 默认使用免费额度，当阿里云不可用时自动切换
# OCR_SPACE_API_KEY=your_api_key

# ============================================================
# hCaptcha 人机验证配置（防自动化下单）
# ============================================================
# 1. 去 https://dashboard.hcaptcha.com 注册免费账号并创建站点
# 2. 获取 Site Key 和 Secret Key 填入下方
# 3. 不配置时默认使用测试 key（始终通过验证），仅用于开发
# 4. 生产环境必须替换为真实 key，否则验证码无防护效果
#
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY=你的_site_key
# HCAPTCHA_SECRET_KEY=0x你的_secret_key

# ============================================================
# 部署说明
# ============================================================
#
# 1. 在宝塔面板中创建 MySQL 数据库
#    - 数据库名: b2bplatform
#    - 用户名: b2buser
#    - 密码: 自定义强密码
#
# 2. 创建数据库表结构
#    在 phpMyAdmin 中运行以下 SQL 创建所有表：
#    https://github.com/l1033794119-glitch/b2b-saas-platform/blob/main/scripts/schema.sql
#
# 3. 配置环境变量
#    在网站目录创建 .env.local 文件并填入上方的值
#    文件路径: /www/wwwroot/b2b-platform/.env.local
#
# 4. 安装依赖并构建
#    在宝塔 SSH 终端执行：
#    cd /www/wwwroot/b2b-platform
#    npm install
#    npm run build
#
# 5. 使用 PM2 启动应用
#    pm2 start npm --name b2b-platform -- run start
#
# ============================================================
# 数据库表说明
# ============================================================
#
# - warehouses: 仓库信息
# - products: 产品信息（包含 SKU、价格、库存等）
# - agents: 代理商信息（包含登录账号、信用额度等）
# - orders: 订单信息（包含产品、运费、状态等）
# - credit_transactions: 信用额度交易记录
# - inventory_logs: 库存操作日志
# - employees: 员工账号（管理员后台登录）
#
# ============================================================
# 登录账号
# ============================================================
#
# 管理员后台：
#   Email: admin@company.com
#   Password: admin123   （首次部署时自动创建）
#
# 代理商后台：
#   代理商账号在管理员后台创建
#   Email: 代理商注册的邮箱
#   Password: 管理员设置的密码
#
# ============================================================